<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= server.name %> - Port Forwards | <%= settings.panel_name || 'NVM Panel' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <% if (settings.panel_bg) { %><style>body{background-image:url('<%= settings.panel_bg %>');background-size:cover;background-attachment:fixed;}</style><% } %>
</head>
<body class="has-sidebar">
<%- include('../partials/sidebar') %>
<div class="main-wrapper">
  <header class="topbar">
    <button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
    <div class="topbar-breadcrumb"><i class="fas fa-network-wired"></i> <%= server.name %> &rsaquo; Port Forward</div>
    <div class="topbar-right"><span class="topbar-user"><i class="fas fa-user"></i> <%= user.username %></span></div>
  </header>
  <main class="content">
    <% if (success && success.length) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <div class="page-header">
      <h2><i class="fas fa-network-wired"></i> Port Forwarding</h2>
      <p class="text-muted">Expose server ports publicly via <strong>Pinggy.io</strong> tunnels</p>
    </div>

    <!-- Add Forward -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-plus-circle"></i> Add Port Forward</div>
      <div class="card-body">
        <form method="POST" action="/vm/<%= server.id %>/ports/add" class="d-flex align-items-end gap-3 flex-wrap">
          <div class="form-group mb-0">
            <label>Local Port on Container</label>
            <input type="number" name="local_port" class="form-control" placeholder="e.g. 80, 3000, 8080" min="1" max="65535" required>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-plug"></i> Create Tunnel
          </button>
        </form>
        <div class="info-box mt-3">
          <i class="fas fa-info-circle"></i>
          Tunnels are created using <strong>Pinggy.io</strong> free tier via SSH. The public URL will appear below after a few seconds. 
          <a href="https://pinggy.io" target="_blank" rel="noopener">Learn more</a>
        </div>
      </div>
    </div>

    <!-- Forward List -->
    <div class="card">
      <div class="card-header">
        <i class="fas fa-list"></i> Active Port Forwards
        <button class="btn btn-xs btn-secondary ms-auto" onclick="refreshList()"><i class="fas fa-sync"></i> Refresh</button>
      </div>
      <div class="card-body p-0">
        <% if (!forwards.length) { %>
          <div class="empty-state"><i class="fas fa-network-wired fa-3x"></i><h3>No forwards yet</h3><p>Add a port above to expose it publicly.</p></div>
        <% } else { %>
          <table class="data-table" id="fwdTable">
            <thead><tr><th>Local Port</th><th>Public URL</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
            <tbody>
              <% forwards.forEach(f => { %>
              <tr>
                <td><code>:<%= f.local_port %></code></td>
                <td>
                  <% if (f.public_url && f.public_url.startsWith('http')) { %>
                    <a href="<%= f.public_url %>" target="_blank" class="url-link">
                      <i class="fas fa-external-link-alt"></i> <%= f.public_url %>
                    </a>
                  <% } else { %>
                    <span class="text-muted"><%= f.public_url || 'Starting...' %></span>
                  <% } %>
                </td>
                <td>
                  <span class="status-badge status-<%= f.active ? 'running' : 'stopped' %>">
                    <span class="status-dot"></span> <%= f.active ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td><%= f.created_at %></td>
                <td>
                  <form method="POST" action="/vm/<%= server.id %>/ports/delete/<%= f.id %>" style="display:inline">
                    <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('Remove this forward?')">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script src="/js/main.js"></script>
<script>
function refreshList() { window.location.reload(); }
// Auto-refresh if any forward is "Starting..."
const hasStarting = document.querySelector('td span.text-muted') !== null;
if (hasStarting) {
  setTimeout(() => window.location.reload(), 4000);
}
</script>
</body>
</html>
