<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel Settings | <%= settings.panel_name || 'NVM Panel' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <% if (settings.panel_bg) { %><style>body{background-image:url('<%= settings.panel_bg %>');background-size:cover;background-attachment:fixed;}</style><% } %>
</head>
<body class="has-sidebar">
<%- include('../partials/sidebar') %>
<div class="main-wrapper">
  <header class="topbar">
    <button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
    <div class="topbar-breadcrumb"><i class="fas fa-cog"></i> Admin &rsaquo; Panel Settings</div>
    <div class="topbar-right"><span class="topbar-user"><i class="fas fa-user-shield"></i> <%= user.username %></span></div>
  </header>
  <main class="content">
    <% if (success && success.length) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <div class="page-header"><h2><i class="fas fa-cog"></i> Panel Settings</h2></div>

    <form method="POST" action="/admin/settings" enctype="multipart/form-data">
      <div class="card mb-4">
        <div class="card-header"><i class="fas fa-tag"></i> General</div>
        <div class="card-body">
          <div class="form-group">
            <label>Panel Name</label>
            <input type="text" name="panel_name" class="form-control" value="<%= settings.panel_name || 'NVM Panel' %>" placeholder="NVM Panel">
            <small class="form-hint">This name appears in the sidebar header and browser title.</small>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><i class="fas fa-image"></i> Branding</div>
        <div class="card-body">
          <div class="form-row">
            <div class="form-group">
              <label>Panel Logo</label>
              <div class="upload-area" id="logoUpload">
                <% if (settings.panel_logo) { %>
                  <img src="<%= settings.panel_logo %>" alt="Current Logo" class="preview-img" id="logoPreview">
                <% } else { %>
                  <i class="fas fa-image fa-3x text-muted" id="logoIcon"></i>
                  <p>Click to upload logo</p>
                <% } %>
              </div>
              <input type="file" name="panel_logo" id="logoInput" accept="image/*" class="file-input" onchange="previewImage(this, 'logoPreview', 'logoIcon')">
              <label for="logoInput" class="btn btn-secondary btn-sm mt-2"><i class="fas fa-upload"></i> Choose Logo</label>
              <small class="form-hint">Recommended: PNG, 200x50px. Shown in sidebar.</small>
            </div>
            <div class="form-group">
              <label>Background Image</label>
              <div class="upload-area" id="bgUpload">
                <% if (settings.panel_bg) { %>
                  <img src="<%= settings.panel_bg %>" alt="Current Background" class="preview-img" id="bgPreview">
                <% } else { %>
                  <i class="fas fa-panorama fa-3x text-muted" id="bgIcon"></i>
                  <p>Click to upload background</p>
                <% } %>
              </div>
              <input type="file" name="panel_bg" id="bgInput" accept="image/*" class="file-input" onchange="previewImage(this, 'bgPreview', 'bgIcon')">
              <label for="bgInput" class="btn btn-secondary btn-sm mt-2"><i class="fas fa-upload"></i> Choose Background</label>
              <small class="form-hint">Full-screen background image for the panel.</small>
            </div>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-save"></i> Save Settings</button>
    </form>
  </main>
</div>
<script src="/js/main.js"></script>
<script>
function previewImage(input, previewId, iconId) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    let preview = document.getElementById(previewId);
    if (!preview) {
      preview = document.createElement('img');
      preview.id = previewId;
      preview.className = 'preview-img';
      const icon = document.getElementById(iconId);
      if (icon) icon.style.display = 'none';
      input.closest('.upload-area').prepend(preview);
    }
    preview.src = e.target.result;
  };
  reader.readAsDataURL(file);
}
</script>
</body>
</html>
