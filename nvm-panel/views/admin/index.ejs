<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel | <%= settings.panel_name || 'NVM Panel' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <% if (settings.panel_bg) { %><style>body{background-image:url('<%= settings.panel_bg %>');background-size:cover;background-attachment:fixed;}</style><% } %>
</head>
<body class="has-sidebar">
<%- include('../partials/sidebar') %>
<div class="main-wrapper">
  <header class="topbar">
    <button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
    <div class="topbar-breadcrumb"><i class="fas fa-shield-alt"></i> Admin Panel</div>
    <div class="topbar-right"><span class="topbar-user"><i class="fas fa-user-shield"></i> <%= user.username %></span></div>
  </header>
  <main class="content">
    <% if (success && success.length) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <div class="page-header">
      <h2><i class="fas fa-shield-alt"></i> Admin Overview</h2>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon bg-blue"><i class="fas fa-users"></i></div>
        <div class="stat-info"><h3><%= stats.users %></h3><p>Total Users</p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon bg-purple"><i class="fas fa-server"></i></div>
        <div class="stat-info"><h3><%= stats.servers %></h3><p>Servers</p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon bg-green"><i class="fas fa-play-circle"></i></div>
        <div class="stat-info"><h3><%= stats.running %></h3><p>Running</p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon bg-orange"><i class="fas fa-sitemap"></i></div>
        <div class="stat-info"><h3><%= stats.nodes %></h3><p>Nodes</p></div>
      </div>
    </div>

    <div class="admin-quick-actions mt-4">
      <h3>Quick Actions</h3>
      <div class="quick-actions-grid">
        <a href="/admin/settings" class="quick-action-card">
          <i class="fas fa-cog fa-2x"></i>
          <span>Panel Settings</span>
          <small>Name, logo, background</small>
        </a>
        <a href="/admin/nodes" class="quick-action-card">
          <i class="fas fa-sitemap fa-2x"></i>
          <span>Manage Nodes</span>
          <small>Add/remove compute nodes</small>
        </a>
        <a href="/admin/servers" class="quick-action-card">
          <i class="fas fa-server fa-2x"></i>
          <span>Manage Servers</span>
          <small>Create & assign VMs</small>
        </a>
        <a href="/admin/users" class="quick-action-card">
          <i class="fas fa-user-shield fa-2x"></i>
          <span>Manage Users</span>
          <small>Create & manage accounts</small>
        </a>
      </div>
    </div>
  </main>
</div>
<script src="/js/main.js"></script>
</body>
</html>
