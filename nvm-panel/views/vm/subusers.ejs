<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= server.name %> - Sub Users | <%= settings.panel_name || 'NVM Panel' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <% if (settings.panel_bg) { %><style>body{background-image:url('<%= settings.panel_bg %>');background-size:cover;background-attachment:fixed;}</style><% } %>
</head>
<body class="has-sidebar">
<%- include('../partials/sidebar') %>
<div class="main-wrapper">
  <header class="topbar">
    <button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
    <div class="topbar-breadcrumb"><i class="fas fa-users"></i> <%= server.name %> &rsaquo; Sub Users</div>
    <div class="topbar-right"><span class="topbar-user"><i class="fas fa-user"></i> <%= user.username %></span></div>
  </header>
  <main class="content">
    <% if (success && success.length) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <div class="page-header"><h2><i class="fas fa-users"></i> Sub Users</h2></div>

    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-user-plus"></i> Add Sub User</div>
      <div class="card-body">
        <% if (!allUsers.length) { %>
          <div class="info-box"><i class="fas fa-info-circle"></i> No other users available to add.</div>
        <% } else { %>
          <form method="POST" action="/vm/<%= server.id %>/subusers/add">
            <div class="form-row">
              <div class="form-group">
                <label>User</label>
                <select name="user_id" class="form-control" required>
                  <option value="">Select user...</option>
                  <% allUsers.forEach(u => { %><option value="<%= u.id %>"><%= u.username %></option><% }) %>
                </select>
              </div>
              <div class="form-group">
                <label>Permissions</label>
                <div class="checkbox-group">
                  <label class="checkbox-label"><input type="checkbox" name="permissions" value="console" checked> Console</label>
                  <label class="checkbox-label"><input type="checkbox" name="permissions" value="files"> Files</label>
                  <label class="checkbox-label"><input type="checkbox" name="permissions" value="ports"> Port Forwards</label>
                </div>
              </div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-user-plus"></i> Add Sub User</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><i class="fas fa-list"></i> Current Sub Users</div>
      <div class="card-body p-0">
        <% if (!subusers.length) { %>
          <div class="empty-state"><i class="fas fa-users fa-3x"></i><h3>No sub users</h3><p>Add users above to grant them access to this server.</p></div>
        <% } else { %>
          <table class="data-table">
            <thead><tr><th>Username</th><th>Permissions</th><th>Added</th><th>Actions</th></tr></thead>
            <tbody>
              <% subusers.forEach(su => { %>
              <tr>
                <td><i class="fas fa-user"></i> <%= su.username %></td>
                <td>
                  <% su.permissions.split(',').forEach(p => { %>
                    <span class="badge badge-info"><%= p %></span>
                  <% }) %>
                </td>
                <td><%= su.created_at %></td>
                <td>
                  <form method="POST" action="/vm/<%= server.id %>/subusers/remove/<%= su.id %>" style="display:inline">
                    <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('Remove this sub user?')">
                      <i class="fas fa-user-minus"></i> Remove
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script src="/js/main.js"></script>
</body>
</html>
